<mujoco model="planar_pushing_visualizer">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.01"/>
  <default>
    <geom friction="0.8 0.02 0.001"/>
  </default>
  <worldbody>
    <geom name="table" type="plane" size="2 2 0.1" rgba="0.18 0.20 0.22 1"/>
    <light pos="0 0 2" directional="true"/>
    <camera name="overview" pos="0 -1.5 1.3" xyaxes="1 0 0 0 0.65 0.75"/>
    <body name="block" pos="0 0 0.15">
      <freejoint name="block_free"/>
      <geom name="block_geom" type="box" size="0.15 0.15 0.15" mass="1"
            rgba="0.15 0.45 0.9 1"/>
    </body>
    <body name="left_pusher" pos="-0.18 0 0.05">
      <freejoint name="left_pusher_free"/>
      <geom name="left_pusher_geom" type="sphere" size="0.03" mass="0.1"
            rgba="0.95 0.35 0.1 1"/>
    </body>
    <body name="right_pusher" pos="0.18 0 0.05">
      <freejoint name="right_pusher_free"/>
      <geom name="right_pusher_geom" type="sphere" size="0.03" mass="0.1"
            rgba="0.95 0.35 0.1 1"/>
    </body>
    <!-- Kinematic, non-colliding desired box footprint. -->
    <body name="goal" pos="0.18 0.02 0.006">
      <freejoint name="goal_free"/>
      <geom name="goal_footprint" type="box" size="0.15 0.15 0.006"
            contype="0" conaffinity="0" rgba="1 0.85 0.05 0.28"/>
    </body>
  </worldbody>
</mujoco>
